# SatQuery AI — Environment Configuration Template
# Copy this file to .env and configure your secret keys for production.

# Application Server
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default; can be postgresql:// for production)
DATABASE_URL=satquery.db

# Authentication & Security Secrets
# Generate a strong 256-bit random secret for production: openssl rand -hex 32
JWT_SECRET=satquery-production-secret-key-replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Google OAuth 2.0 Credentials (Leave blank if not configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email SMTP Delivery Configuration (Optional for real transactional emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@satquery.ai
